# ---------------------------------------------------------------------------
# SOS PAP Revolution - environment configuration
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Server-side DeepSeek configuration (used by /api/assistant and /api/quiz).
# Leave DEEPSEEK_API_KEY empty to run in curated (offline) demonstration mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: request timeout in milliseconds for the model call.
DEEPSEEK_TIMEOUT_MS=15000

# Optional: absolute site URL, used for metadata in production deployments.
# NEXT_PUBLIC_SITE_URL=https://example.org

# ---------------------------------------------------------------------------
# Notes
# - This application stores no personal data. The demonstration profile lives
#   in browser memory only, so no database connection string is required.
# - No secret may ever be prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
